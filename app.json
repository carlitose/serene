{
  "expo": {
    "name": "Serene",
    "slug": "serene",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "scheme": "serene",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carlogiuseppesergi.sereneapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Serene needs camera access to send photos in messages",
        "NSMicrophoneUsageDescription": "Serene needs microphone access to send voice messages",
        "NSPhotoLibraryUsageDescription": "Serene needs photo library access to send photos in messages",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "8GJ7L6JT93"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.carlosergi.serene",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ]
    ],
    "extra": {
      "router": {
        "root": "./src/app"
      },
      "eas": {
        "projectId": "140f9105-f4db-48ac-8cf1-de9f009ed233"
      }
    }
  }
}
